# ---------------------------------------------------------------------------
# Lead Call Management System - environment
# Copy to .env.local and fill in. Every integration is optional: if its keys
# are missing the pipeline marks that step "skipped" and carries on.
# ---------------------------------------------------------------------------

# Public base URL of this app. Used in Telegram / email links back to a lead.
# Locally use an ngrok/cloudflared tunnel URL so Vaani can reach the webhook.
APP_URL=http://localhost:3000

# SQLite file (Node built-in sqlite). Created on first run.
DATABASE_PATH=./data/lcms.db

# --- Vaani (voice agent) ----------------------------------------------------
# Shared secret Vaani sends in the "x-webhook-secret" header (or ?secret=).
VAANI_WEBHOOK_SECRET=
VAANI_API_KEY=

# --- Gemini (lead scoring) --------------------------------------------------
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram (designer brief) ----------------------------------------------
TELEGRAM_BOT_TOKEN=
# Designer group / channel / user chat id, e.g. -1001234567890
TELEGRAM_CHAT_ID=

# --- Resend (email to Nikhil with the price link) ---------------------------
RESEND_API_KEY=
# Must be on a domain verified in Resend, e.g. "Aangan Leads <leads@aangan.studio>"
RESEND_FROM=
NIKHIL_EMAIL=

# --- Calendar (consultation booking) ----------------------------------------
# "local" = slots held in this app's database only (default until a provider
# is chosen). Provider adapters plug into src/lib/integrations/calendar.ts.
CALENDAR_PROVIDER=local
CALENDAR_API_KEY=
# Consultation slots offered to callers (24h, Asia/Kolkata), comma separated
CONSULT_SLOT_TIMES=11:00,15:00,17:30
CONSULT_SLOT_MINUTES=60

# --- HubSpot (CRM) ----------------------------------------------------------
# Private app access token with crm.objects.contacts.write + crm.objects.notes (via contacts) scopes
HUBSPOT_ACCESS_TOKEN=

# --- Running-cost rates (for the dashboard's cost card) ---------------------
# Leave blank to show usage without a rupee figure.
VAANI_INR_PER_MIN=
GEMINI_USD_PER_M_INPUT=
GEMINI_USD_PER_M_OUTPUT=
USD_TO_INR=88
